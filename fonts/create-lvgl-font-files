#!/bin/sh
#
# Convert TTF font files to LVGL .c files.
# Includes the font licence reference at the top of the generated files.

ttf_to_lvgl () {
  font_file="$1"
  size="$2"
  range="$3"
  licence="$4"
  lv_font_file="$5"

  if [ ! -s "$font_file" ]; then
    echo "$0: ttf_to_lvgl $font_file not found"
    exit 1
  fi

  if [ -z "$lv_font_file" ]; then
    echo "$0: ttf_to_lvgl $lv_font_file not specified"
    exit 1
  fi

  npx lv_font_conv@1.5.3 \
      --font "$font_file" --size $size --bpp 1 \
      --format lvgl --no-compress \
      -r "$range" \
      -o "$lv_font_file"

  sed -i '' "
1i\\
/*\\
 * SPDX-License-Identifier: ${licence}\\
 */\\

/^#ifdef LV_LVGL_H_INCLUDE_SIMPLE$/,/^#endif$/c\\
#include <lvgl.h>\\
" "$lv_font_file"
}

ttf_to_lvgl SplineSans/static/SplineSans-Medium.ttf 20 "0x20,0x25,0x2E,0x30-0x3A,0x43-0x45,0x48,0x4E-0x4F,0x52,0xB0" OFL-1.1 lv_font_splinesans_medium_20.c

ttf_to_lvgl SplineSans/static/SplineSans-Bold.ttf 72 "0x2D-0x2E,0x30-0x39" OFL-1.1 lv_font_splinesans_bold_72.c

ttf_to_lvgl Phosphor.ttf 32 "0xE210,0xE5C6" MIT lv_font_phosphor_32.c
