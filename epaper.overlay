/ {
	chosen {
		zephyr,display = &ssd1681;
	};

	mipi_dbi: mipi-dbi-spi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&arduino_spi>;
		dc-gpios    = <&arduino_header 15 GPIO_ACTIVE_HIGH>; /* D9  (P1.11) */
		reset-gpios = <&arduino_header 14 GPIO_ACTIVE_LOW>;  /* D8  (P1.10) */
		#address-cells = <1>;
		#size-cells = <0>;

		ssd1681: ssd1681@0 {
			compatible = "solomon,ssd1681";
			mipi-max-frequency = <4000000>;
			reg = <0>;
			width = <200>;
			height = <200>;
			busy-gpios = <&arduino_header 13 GPIO_ACTIVE_HIGH>; /* D7 (P1.09) */

			partial {};
		};
	};
};
